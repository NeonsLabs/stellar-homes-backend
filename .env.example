PORT=4000
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Only needed for a network not in: testnet, mainnet, futurenet, local
# STELLAR_NETWORK_PASSPHRASE=

# Deployed Soroban contract ids, as printed by stellar-homes-contract's
# scripts/deploy.sh (REGISTRY=, LENDING=, MORTGAGE=). Set all three to use the
# deployed contracts; leave all three empty to run the simulated ledger.
PROPERTY_REGISTRY_CONTRACT_ID=
LENDING_POOL_CONTRACT_ID=
MORTGAGE_POOL_CONTRACT_ID=

# The contracts' admin account (the multisig, after handover). Required with
# deployed contracts: admin transactions are prepared for it to sign. The
# backend never holds a secret key.
ADMIN_ADDRESS=

# Simulated ledger only: stands in for the admin's signature on admin calls.
ADMIN_API_KEY=
# Simulated ledger only: grace period before a late loan can be defaulted
# (deploy.sh default, 14 days), the underwriter registered at deploy (defaults
# to the admin), and POST /api/dev/advance-time.
GRACE_SECS=1209600
UNDERWRITER_ADDRESS=
ALLOW_TIME_TRAVEL=false
# The simulated ledger verifies no signatures and refuses to start when
# NODE_ENV=production unless this is set.
ALLOW_SIMULATED_LEDGER=false
